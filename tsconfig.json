{
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true
	},
	"files": [],
	"include": [],
	"references": [
		{
			"path": "./tsconfig.lib.json"
		},
		{
			"path": "./tsconfig.storybook.json"
		},
		{
			"path": "./tsconfig.spec.json"
		}
	]
}
